{
  "name": "dsh-quiet-hours",
  "version": "0.1.0",
  "description": "Work-hours away mode for WeChat in DeepSeek Harness: silence the AI and answer incoming messages with one fixed line.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "wechatagent",
    "quiet-hours",
    "auto-reply",
    "out-of-office"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "check.mjs",
    "test",
    "docs",
    "examples",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/wiring.mjs",
    "check": "node check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rnfmabjE/dsh-quiet-hours.git"
  },
  "homepage": "https://github.com/rnfmabjE/dsh-quiet-hours#readme",
  "bugs": {
    "url": "https://github.com/rnfmabjE/dsh-quiet-hours/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
